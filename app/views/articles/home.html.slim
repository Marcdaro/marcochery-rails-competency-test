- if @trending_articles.empty?
  p.py-16.text-center.text-muted No articles have been published yet.
- else
  / Trending Now: the three newest stories from any category
  section.mb-12 aria-labelledby="trending-heading"
    div class="mb-5"
      h2#trending-heading class="border-l-4 border-red-600 pl-3 font-serif text-3xl font-bold text-ink" Trending Now
      p class="mt-1 pl-4 text-sm text-muted" The newest stories from across the site.
    = render "articles/story_section", articles: @trending_articles, show_category: true

  / One section per category, alphabetically, each with its newest three stories
  - @articles_by_category.each do |category, articles|
    section.mb-12.border-t.border-strong.pt-5 data-category=category
      div class="mb-5 flex items-baseline justify-between gap-4"
        h2 class="border-l-4 border-red-600 pl-3 font-serif text-3xl font-bold text-ink"
          = link_to category, articles_path(category: category), class: "hover:text-accent-hover"
        = link_to "More #{category} →", articles_path(category: category),
          class: "text-sm font-semibold whitespace-nowrap text-accent hover:text-accent-hover"
      = render "articles/story_section", articles: articles, show_category: false
