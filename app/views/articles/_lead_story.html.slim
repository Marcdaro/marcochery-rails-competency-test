/ The big story on the left of a section: the photo fills the card, with the headline over it
article class="group relative min-h-72 overflow-hidden rounded-lg bg-neutral-900 sm:min-h-80"
  = render "articles/story_image", article: article, letter_class: "-top-6 right-4 text-[12rem] text-white/10"
  / Darkens the bottom of the photo so the white headline stays readable
  div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-transparent"

  div class="relative flex h-full min-h-72 flex-col justify-between p-5 sm:min-h-80 sm:p-6"
    span class="self-start rounded bg-red-700 px-2 py-0.5 text-xs font-semibold tracking-wide text-white uppercase" = article.category

    div
      h3 class="font-serif text-2xl leading-tight font-bold text-white sm:text-3xl"
        = link_to article.title, article_path(article), class: "after:absolute after:inset-0 group-hover:underline"
      p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-200" = truncate(article.content, length: 150)
      p class="mt-3 flex items-center gap-1.5 text-xs font-medium text-neutral-300"
        = render "articles/clock_icon"
        = read_time(article)
