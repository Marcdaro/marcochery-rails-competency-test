<!DOCTYPE html>
<html class="h-full bg-page">
  <head>
    <title><%= content_for(:title) || "Marco News Network" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Marco News Network">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Apply the saved theme before the page draws, so it never flashes the wrong one.
        No saved choice yet? Follow the visitor's system setting. %>
    <script>
      try {
        var theme = localStorage.getItem("theme");
        if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      } catch (e) {}
    </script>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tailwind's compiled stylesheet (built from app/assets/tailwind/application.css) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col bg-page text-body antialiased">
    <%# The whole header sticks to the top of the screen while the page scrolls.
        "theme-dark" keeps it dark (bg-bar) with dark-theme colours in both themes. %>
    <header class="theme-dark sticky top-0 z-20 bg-bar shadow-lg shadow-black/40">
      <%# 1. Utility strip: today's date and account links %>
      <div class="border-b border-line">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-1.5 text-xs text-neutral-300">
          <span class="hidden sm:inline"><%= Date.current.strftime("%A, %B %-d, %Y") %></span>

          <div class="ml-auto flex items-center gap-3">
            <%# Light/dark switch (app/javascript/controllers/theme_controller.js) %>
            <button type="button" data-controller="theme" data-action="theme#toggle"
                    class="cursor-pointer rounded-full p-1 text-neutral-300 hover:bg-raised hover:text-white"
                    title="Switch light/dark theme" aria-label="Switch light/dark theme">
              <%# Moon in the light theme, sun in the dark theme %>
              <svg aria-hidden="true" class="h-4 w-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
              </svg>
              <svg aria-hidden="true" class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="4" />
                <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
            </button>

            <% if user_signed_in? %>
              <%= link_to current_user.email, edit_user_registration_path,
                    class: "hover:text-white", title: "Account settings" %>
              <% unless current_user.role == :user %>
                <span class="badge"><%= current_user.role %></span>
              <% end %>
              <% if current_user.has_role?(:admin) %>
                <%= link_to "Manage Users", admin_users_path, class: "font-semibold text-red-500 hover:text-red-400" %>
              <% end %>
              <%= button_to "Log out", destroy_user_session_path, method: :delete,
                    class: "cursor-pointer font-semibold text-white hover:text-neutral-300" %>
            <% else %>
              <%= link_to "Log in", new_user_session_path, class: "font-semibold text-white hover:text-neutral-300" %>
              <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary rounded-full px-3 py-1 text-xs" %>
            <% end %>
          </div>
        </div>
      </div>

      <%# 2. Masthead, and the search box on the right %>
      <div class="mx-auto grid max-w-6xl items-center gap-3 lg:gap-6 px-4 py-3 sm:py-4 lg:grid-cols-[1fr_auto_1fr]">
        <div class="hidden lg:block"></div>
        <div class="text-center">
          <%= link_to root_path, class: "font-serif text-4xl font-black tracking-tight text-white sm:text-5xl xl:text-6xl" do %>
            Marco <span class="text-red-600">News</span> Network
          <% end %>
        </div>
        <%= form_with url: articles_path, method: :get, role: "search",
              class: "relative w-full justify-self-center sm:max-w-xs lg:max-w-52 lg:justify-self-end" do %>
          <label for="site-search" class="sr-only">Search articles</label>
          <svg aria-hidden="true" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m20 20-3.5-3.5" />
          </svg>
          <%= search_field_tag :q, @query, id: "site-search", placeholder: "Search articles...",
                class: "w-full rounded-md border border-line bg-surface py-2 pr-3 pl-9 text-sm text-white placeholder:text-neutral-400 focus:border-red-600 focus:ring-2 focus:ring-red-600/30 focus:outline-none" %>
        <% end %>
      </div>

      <%# 3. Section nav: Home, one link per category, All Articles %>
      <nav aria-label="Sections" class="border-b border-line">
        <div class="mx-auto max-w-6xl overflow-x-auto px-4">
          <ul class="flex justify-start gap-6 text-sm font-semibold tracking-wide whitespace-nowrap uppercase sm:justify-center sm:gap-8">
            <li><%= section_nav_link "Home", root_path, active: current_section == :home %></li>
            <% nav_categories.each do |category| %>
              <li><%= section_nav_link category, articles_path(category: category), active: current_section == category %></li>
            <% end %>
            <li><%= section_nav_link "All Articles", articles_path, active: current_section == :all %></li>
          </ul>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <% if notice.present? %>
        <p class="notice notice-box mb-6"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="alert error-box mb-6"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="theme-dark mt-8 border-t border-line bg-bar">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-6 text-sm text-neutral-400">
        <span class="font-serif font-bold text-white">Marco <span class="text-red-600">News</span> Network</span>
        <span>Built with Ruby on Rails</span>
      </div>
    </footer>
  </body>
</html>
