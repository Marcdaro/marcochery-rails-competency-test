div class="mb-6 flex flex-wrap items-end justify-between gap-4 border-b-2 border-strong pb-3"
  div
    h1.font-serif.text-4xl.font-black.tracking-tight.text-ink Manage Users
    p.mt-1.text-sm.text-muted = pluralize(@users.size, "user")
  = link_to "+ Create User", new_admin_user_path, class: "btn btn-primary"

.card.overflow-x-auto
  table.w-full.text-left.text-sm
    thead.border-b.border-line.bg-raised.text-xs.tracking-wide.text-muted.uppercase
      tr
        th.px-4.py-3.font-semibold Email
        th.px-4.py-3.font-semibold Role
        th.px-4.py-3.font-semibold Articles
        th.px-4.py-3.font-semibold Joined
        th.px-4.py-3
          span.sr-only Actions
    tbody.divide-y.divide-line
      - @users.each do |user|
        tr
          td.px-4.py-3.font-medium.text-ink
            = user.email
            - if user == current_user
              span.ml-2.text-xs.text-muted (you)
          td.px-4.py-3
            span.badge = user.role
          td.px-4.py-3.text-body = user.articles.size
          td.px-4.py-3.text-body = user.created_at.strftime("%b %-d, %Y")
          td.px-4.py-3.text-right
            = link_to "Edit", edit_admin_user_path(user), class: "link", "aria-label": "Edit #{user.email}"
