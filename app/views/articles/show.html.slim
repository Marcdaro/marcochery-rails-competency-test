article.mx-auto.max-w-3xl
  = link_to @article.category, articles_path(category: @article.category),
    class: "text-sm font-semibold tracking-wide text-accent uppercase hover:underline"

  h1 class="mt-2 font-serif text-4xl leading-tight font-black tracking-tight text-ink sm:text-5xl" = @article.title

  p.mt-4.border-y.border-line.py-3.text-sm.text-muted
    | By
    strong.font-semibold.text-ink = " #{@article.user.email}"
    = " · #{@article.created_at.strftime('%B %-d, %Y')}"

  div class="mt-8 font-serif text-lg leading-relaxed text-ink sm:text-xl"
    = simple_format(@article.content, class: "mb-6")

  - if current_user.has_role?(:editor) && @article.user_id == current_user.id
    .mt-10.flex.flex-wrap.gap-3.border-t.border-line.pt-6
      = link_to "Edit Article", edit_article_path(@article), class: "btn btn-secondary"
      = button_to "Delete Article",
        article_path(@article),
        method: :delete,
        class: "btn btn-danger",
        form: { data: { turbo_confirm: "Do you want to delete this article?" } }

  p.mt-10.border-t-2.border-strong.pt-4
    = link_to "← More in #{@article.category}", articles_path(category: @article.category), class: "link text-sm"
