div class="mb-6 flex flex-wrap items-end justify-between gap-4 border-b-2 border-strong pb-3"
  div
    - if @category || @query
      p.mb-1.text-sm = link_to "← All Articles", articles_path, class: "link"
    h1.font-serif.text-4xl.font-black.tracking-tight.text-ink = @category || "All Articles"
    - if @query
      p.mt-1.text-sm.text-body = "Search results for “#{@query}”"
    p.mt-1.text-sm.text-muted = pluralize(@articles.size, "article")

  - if user_signed_in? && current_user.has_role?(:editor)
    = link_to "+ Create Article", new_article_path, class: "btn btn-primary"

- if @articles.empty?
  p.py-16.text-center.text-muted
    - if @query
      = "No articles match “#{@query}”."
    - else
      = @category ? "No articles in #{@category} yet." : "No articles have been published yet."

.divide-y.divide-line
  - @articles.each do |article|
    article.flex.gap-6.py-6
      .min-w-0.flex-1
        - unless @category
          = link_to article.category, articles_path(category: article.category),
            class: "text-xs font-semibold tracking-wide text-accent uppercase hover:underline"
        h2.mt-1.font-serif.text-2xl.leading-snug.font-bold.text-ink
          = link_to article.title, article_path(article), class: "hover:text-accent-hover"
        p.mt-2.max-w-3xl.leading-relaxed.text-body = truncate(article.content, length: 220)
        p.mt-3.text-xs.text-muted
          = "By #{article.user.email} · #{article.created_at.strftime('%b %-d, %Y')}"
      / Thumbnail on the right (hidden on phones)
      = link_to article_path(article), tabindex: -1, aria: { hidden: true },
        class: "relative hidden h-32 w-48 shrink-0 overflow-hidden rounded-md bg-neutral-900 sm:block"
        = render "articles/story_image", article: article, letter_class: "right-2 bottom-0 text-7xl text-white/15"
